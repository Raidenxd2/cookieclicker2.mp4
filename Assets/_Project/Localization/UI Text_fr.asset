    m_Metadata:
      m_Items: []
  - m_Id: 370683242577932288
    m_Localized: "Ajoute des effets visuels \xE0 des \xE9l\xE9ments tels que la perceuse."
    m_Metadata:
      m_Items: []
  - m_Id: 370683241978146816
    m_Localized: "Le post-traitement ajoute des effets visuels \xE0 l'\xE9cran."
